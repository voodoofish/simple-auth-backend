{
  "ts-node": {
    "transpileOnly": true,
    "noImplicitAny": false,
    "files": true,
  },
  "compilerOptions": {
    "target": "ES6",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "outDir": ".dist",
    "sourceMap": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],

}